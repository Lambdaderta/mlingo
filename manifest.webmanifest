    },
    {
      "name": "Карта",
      "short_name": "Карта",
      "description": "Открыть дорожную карту",
      "url": "./?screen=roadmap",
      "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
