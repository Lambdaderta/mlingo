SITE_DOMAIN=mlingo.online

POSTGRES_DB=mlingo
POSTGRES_USER=mlingo
POSTGRES_PASSWORD=change-me-to-a-long-random-value

MLINGO_ALLOWED_ORIGIN=https://mlingo.online

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://mlingo.online/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email public_repo
GITHUB_SOLUTIONS_REPO_NAME=mlingo-solutions

# If Docker Hub rate-limits unauthenticated pulls, run `docker login` on the
# server or override these with a registry mirror that you trust.
PYTHON_IMAGE=python:3.12-slim
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
