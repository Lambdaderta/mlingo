{
  "name": "mlingo",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first ML coding trainer.",
  "scripts": {
    "serve": "python3 server.py",
    "check": "npm test && npm run test:web && npm run test:site",
    "check:syntax": "node --check app.js",
    "audit:lessons": "python3 scripts/audit_lessons.py",
    "test": "npm run check:syntax && npm run test:server && npm run test:static && npm run test:lessons && npm run audit:lessons",
    "test:server": "PYTHONPYCACHEPREFIX=/tmp/pycache python3 -m py_compile server.py",
    "test:static": "node scripts/test_static_app.mjs",
    "test:lessons": "node scripts/test_lesson_packs.mjs",
    "test:web": "npm run cap:prepare && node scripts/test_capacitor_web.mjs",
    "test:site": "node scripts/test_http_smoke.mjs",
    "cap:prepare": "bash scripts/prepare_capacitor_web.sh",
    "cap:sync": "npm run cap:prepare && cap sync",
    "android:add": "npm run cap:prepare && cap add android",
    "android:debug": "npm run cap:prepare && cap sync android && cd android && ./gradlew assembleDebug",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4"
  }
}
