DATABASE_URL=postgresql://mlingo:mlingo@localhost:5432/mlingo
MLINGO_ALLOWED_ORIGIN=http://localhost:4180
PORT=4180

# Обязательно для входа через GitHub OAuth App.
# Callback URL в GitHub должен совпадать с:
# http://localhost:4180/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4180/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email public_repo
GITHUB_SOLUTIONS_REPO_NAME=mlingo-solutions
